# Configuração da API convert-docx-html (Backend)
#
# IMPORTANTE: Copie este arquivo para .env e ajuste os valores conforme necessário
# As variáveis devem começar com REACT_APP_ para serem acessíveis no React

# Porta do servidor de desenvolvimento do frontend
PORT=3005

# URL base da API convert-docx-html (backend)
# Para desenvolvimento local (backend rodando na porta 3000):
REACT_APP_CONVERTER_API_URL=http://localhost:3000

# API Key para autenticação (deve ser a mesma configurada no backend)
# Verifique o arquivo .env do projeto convert-docx-html para obter a API_KEY
REACT_APP_CONVERTER_API_KEY=sua-api-key-secreta
